import os
import requests
from requests.exceptions import HTTPError, Timeout, ConnectionError

# 1. Define configuration constants
API_URL = "https://httpbin.org/post"
API_TOKEN = os.getenv("MY_API_TOKEN", "mock_secret_token_123")

with requests.Session() as session:
    
    # Define reusable headers for all requests in this session
    session.headers.update({
        "Authorization": f"Bearer {API_TOKEN}",
        "Accept": "application/json",
        "User-Agent": "AdvancedPythonClient/1.0"
    })

# Prepare complex structured data payload
    payload = {
        "userId": 42,
        "action": "create_report",
        "meta": {
            "tags": ["production", "financials"],
            "priority": "high"
        }
    }

  try:
        # Construct the execution block safely handling errors
        with open("summary.csv", "rb") as csv_file:
            files = {"attachment": ("summary.csv", csv_file, "text/csv")}

 print(f"Sending POST request to {API_URL}...")
            
            # Execute POST request with explicit data, files, and timeout
            response = session.post(
                url=API_URL,
                json=payload,         # Automatically sets Content-Type to application/json
                files=files,          # Bundles file data seamlessly
                timeout=(3.05, 10),   # (Connect timeout, Read timeout) in seconds
                allow_redirects=False # Prevent accidental security token exposure via redirect
            )


            # Parse response content
            response_data = response.json()
            print("Request successful!")
            print(f"Status Code: {response.status_code}")
            print(f"Server Response ID: {response_data.get('id', 'N/A')}")
